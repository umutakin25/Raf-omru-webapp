{
  "name": "raf-omru",
  "version": "0.1.0",
  "private": true,
  "description": "Kafeler icin pasta/tatli raf omru takip uygulamasi (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "tail": "wrangler tail --config wrangler.toml",
    "db:local": "wrangler d1 execute raf-omru --local  --config wrangler.toml --file=./schema.sql",
    "db:remote": "wrangler d1 execute raf-omru --remote --config wrangler.toml --file=./schema.sql",
    "seed:local": "wrangler d1 execute raf-omru --local  --config wrangler.toml --file=./seed.sql",
    "seed:remote": "wrangler d1 execute raf-omru --remote --config wrangler.toml --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260825.1": true
  }
}
